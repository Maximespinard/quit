# Push sender configuration. Copy to `.env` (gitignored) for a local run; on the VPS the
# values live only in the container's environment. Never commit real values.

# Bearer token every request must carry. Same value as the app's build configuration.
# At least 32 characters — generate with: openssl rand -base64 48
PUSH_SHARED_SECRET=

# VAPID key pair identifying this server to the push services — generate once with:
# npx web-push generate-vapid-keys
# The public key is also the app's `applicationServerKey`; rotating it invalidates the subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact for the push services: a mailto: or https:// URL (Apple rejects anything else).
VAPID_SUBJECT=mailto:you@example.com

# Optional. Defaults: 8080 and /data/state.json (the container's volume).
PORT=8080
DATA_FILE=./data/state.json
