#!/bin/sh
# Pre-commit gate. Install once per clone: git config core.hooksPath .githooks
set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Run 'brew install gitleaks'." >&2
  exit 1
fi

gitleaks protect --staged --redact --verbose

# Out-of-scope wording gate. The word list lives at .git/info/banned-words
# (one regex per line) so it never enters the repository or its history.
# No list, no gate — create the file to enable it.
# --git-common-dir, not --git-dir: inside a worktree the latter points at
# .git/worktrees/<name>, where the list does not live.
banned_words="$(git rev-parse --path-format=absolute --git-common-dir)/info/banned-words"
if [ -f "$banned_words" ]; then
  if git diff --cached --unified=0 --diff-filter=ACM |
    grep '^+' |
    grep -i -E -q -f "$banned_words"; then
    echo "pre-commit: staged changes contain out-of-scope wording (see CLAUDE.md > Interdits)." >&2
    echo "pre-commit: the offending terms are listed in $banned_words." >&2
    exit 1
  fi
fi
