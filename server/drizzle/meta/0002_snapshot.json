      "checkConstraints": {
        "facts_type": {
          "name": "facts_type",
          "value": "\"facts\".\"type\" IN ('quit-moment', 'craving', 'patch-application', 'lapse')"
        },
        "facts_quit_moment": {
          "name": "facts_quit_moment",
          "value": "\"facts\".\"type\" <> 'quit-moment' OR (\"facts\".\"intensity\" IS NULL AND \"facts\".\"held_to_end\" IS NULL AND \"facts\".\"dose_mg\" IS NULL AND \"facts\".\"site\" IS NULL AND \"facts\".\"count\" IS NULL)"
        },
        "facts_craving": {
          "name": "facts_craving",
          "value": "\"facts\".\"type\" <> 'craving' OR (\"facts\".\"intensity\" IS NOT NULL AND \"facts\".\"intensity\" IN (1, 2, 3) AND \"facts\".\"held_to_end\" IS NOT NULL AND \"facts\".\"held_to_end\" IN (0, 1) AND \"facts\".\"dose_mg\" IS NULL AND \"facts\".\"site\" IS NULL AND \"facts\".\"count\" IS NULL)"
        },
        "facts_patch_application": {
          "name": "facts_patch_application",
          "value": "\"facts\".\"type\" <> 'patch-application' OR (\"facts\".\"dose_mg\" IS NOT NULL AND \"facts\".\"dose_mg\" > 0 AND (\"facts\".\"site\" IS NULL OR \"facts\".\"site\" IN ('arm-left', 'arm-right', 'chest-left', 'chest-right', 'hip-left', 'hip-right')) AND \"facts\".\"intensity\" IS NULL AND \"facts\".\"held_to_end\" IS NULL AND \"facts\".\"count\" IS NULL)"
        },
        "facts_lapse": {
          "name": "facts_lapse",
          "value": "\"facts\".\"type\" <> 'lapse' OR (\"facts\".\"count\" IS NOT NULL AND \"facts\".\"count\" >= 1 AND \"facts\".\"intensity\" IS NULL AND \"facts\".\"held_to_end\" IS NULL AND \"facts\".\"dose_mg\" IS NULL AND \"facts\".\"site\" IS NULL)"
        }
      }
    },
