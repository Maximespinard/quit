    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@quit/contract": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
