# Server configuration. Copy to `.env` (gitignored) for a local run; in the container the values
# live in its environment. Never commit real values: the VAPID private key is a secret. The
# device key is not configured here: it lives in the database, as a hash.

# Required. Directory of the SQLite database (quit.db), created when missing.
DATA_DIR=./data

# Required. VAPID key pair identifying this server to the push services — generate once with:
# npx web-push generate-vapid-keys
# The public key is also the app's `applicationServerKey`; rotating it invalidates the subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Required. Contact for the push services: a mailto: or https:// URL (Apple rejects anything else).
VAPID_SUBJECT=mailto:you@example.com

# Optional. Defaults: 8080 and info (fatal, error, warn, info, debug, trace or silent).
PORT=8080
LOG_LEVEL=info

# Optional. Reverse proxies between the clients and the server (default 0). Behind the tunnel,
# 1: the failed-auth rate limit then counts per client address, not per proxy.
TRUST_PROXY=0
